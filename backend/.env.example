PROJECT_NAME=AI Crypto Advisor API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_crypto_advisor
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production must set a real long random SECRET_KEY.
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
EXTERNAL_API_TIMEOUT_SECONDS=10
# Local backend reads backend/.env. Deployment environment variables override .env values.
# OPENROUTER_API_KEY enables real AI insights. Leave empty to use personalized static fallback.
OPENROUTER_API_KEY=
# You can change the model if the selected free model is unavailable or returns empty content.
OPENROUTER_MODEL=openrouter/free
